#include <stdio.h>
#include <stdlib.h>

void sort(int arr[], int n) {
    int temp;
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
}

void scan_disk_scheduling(int requests[], int n, int head, int direction, int disk_size) {
    int seek_sequence[100];
    int seek_count = 0, index = 0;

    // Sort the request array
    sort(requests, n);

    // Find the request closest to the initial head position in the specified direction
    int pos;
    for (pos = 0; pos < n; pos++) {
        if (requests[pos] >= head) break;
    }

    // Move in the initial direction
    if (direction == 1) {  // moving towards the end of the disk
        for (int i = pos; i < n; i++) {
            seek_sequence[index++] = requests[i];
            seek_count += abs(requests[i] - head);
            head = requests[i];
        }
        // Go to the end of the disk and then reverse direction
        seek_sequence[index++] = disk_size - 1;
        seek_count += abs(disk_size - 1 - head);
        head = disk_size - 1;

        // Now move towards the start of the disk
        for (int i = pos - 1; i >= 0; i--) {
            seek_sequence[index++] = requests[i];
            seek_count += abs(requests[i] - head);
            head = requests[i];
        }
    } else {  // moving towards the start of the disk
        for (int i = pos - 1; i >= 0; i--) {
            seek_sequence[index++] = requests[i];
            seek_count += abs(requests[i] - head);
            head = requests[i];
        }
        // Go to the start of the disk and then reverse direction
        seek_sequence[index++] = 0;
        seek_count += abs(head - 0);
        head = 0;

        // Now move towards the end of the disk
        for (int i = pos; i < n; i++) {
            seek_sequence[index++] = requests[i];
            seek_count += abs(requests[i] - head);
            head = requests[i];
        }
    }

    printf("Total seek operations: %d\n", seek_count);
    printf("Seek sequence: ");
    for (int i = 0; i < index; i++) {
        printf("%d ", seek_sequence[i]);
    }
    printf("\n");
}

int main() {
    int disk_size, head, direction;
    int n; // Number of requests

    printf("Enter the disk size: ");
    scanf("%d", &disk_size);

    printf("Enter the number of requests: ");
    scanf("%d", &n);

    int requests[n];
    printf("Enter the request sequence:\n");
    for (int i = 0; i < n; i++) {
        scanf("%d", &requests[i]);
    }

    printf("Enter the initial head position: ");
    scanf("%d", &head);

    printf("Enter the initial direction (1 for high, 0 for low): ");
    scanf("%d", &direction);

    scan_disk_scheduling(requests, n, head, direction, disk_size);

    return 0;
}

